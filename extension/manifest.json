{
  "manifest_version": 3,
  "name": "Agent Browser Control",
  "version": "0.10.0",
  "description": "Permet à n'importe quel agent MCP de piloter le navigateur (équivalent de Claude in Chrome).",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "sidePanel",
    "offscreen",
    "downloads",
    "history",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Browser Control",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "stop-all": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Tout arrêter (arrêt d'urgence des agents)"
    },
    "resume-all": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Laisser les agents reprendre"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'; img-src 'none'"
  }
}
